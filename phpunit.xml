<?xml version="1.0" encoding="UTF-8"?>
<phpunit
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:noNamespaceSchemaLocation="https://schema.phpunit.de/10.5/phpunit.xsd"
    bootstrap="tests/bootstrap.php"
    colors="true"
    displayDetailsOnTestsThatTriggerWarnings="true"
    failOnRisky="true"
    failOnWarning="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory suffix="Test.php">tests</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory suffix=".php">src</directory>
        </include>
        <exclude>
            <!--
                Admin screens are WordPress render/callback glue (list tables,
                upload forms, notices, menu registration) exercised through
                WordPress at runtime rather than in unit tests, so they are
                excluded from the coverage denominator — the same call Reach
                and Integrity make for their own src/Admin.
            -->
            <directory suffix=".php">src/Admin</directory>
        </exclude>
    </source>
</phpunit>
